        {
          "topic": "Veterans",
          "value": "Ensure veterans have the tools to stay safe in battle, access to high quality healthcare, and education and employment opportunities at home",
          "snippet": "Whether it be ensuring they have the tools to stay safe in battle, access to high quality healthcare, or education and employment opportunities here at home, our men and women in uniform deserve our gratitude and our support."
        },
        {
          "topic": "Water",
          "value": "Secure a reliable and clean supply of water for farmers, families, and entire communities to strengthen the economy",
          "snippet": "In the Central Valley, life as we know it is dependent upon securing a reliable and clean supply of water. Farmers, families, and entire communities must receive the water they need to strengthen the economy and raise our families."
        },
        {
          "topic": "Immigration",
          "value": "Comprehensive repair of the broken immigration system",
          "snippet": "David knows that our current system is broken and in need of comprehensive repair."
        },
