      "bio": {
        "employment_record": {
          "value": "Bob Brooks has been a firefighter, a bartender, a teamster, and a baseball coach. Bob has had a lot of jobs — bartender, landscaper, baseball coach, Teamster. Bob spent 20 years as a firefighter in the City of Bethlehem.",
          "source_url": "https://www.electbobbrooks.net/",
          "snippet": "Bob Brooks has been a firefighter, a bartender, a teamster, and a baseball coach — he is a working-class fighter with a proven record of leadership, a lifetime of service, and the authenticity needed to win in one of the nation's most competitive districts. Supported by Pennsylvania Lieutenant Governor Austin Davis and Senator Bernie Sanders, Bob is ready to flip PA-07 and bring a voice for working families to Congress. Photos courtesy Facebook Meet Bob Brooks Washington needs to do better. Bob's tough enough to get it done. Washington, D.C. is on fire, and working people keep getting burned. Bob Brooks is a firefighter running for Congress to put the fire out and make Washington work for us. Bob has had a lot of jobs — bartender, landscaper, baseball coach, Teamster. He knows Washington needs to do better, and he's tough enough to get the job done for us. Bob spent 20 years as a firefighter in the City of Bethlehem.",
          "source_type": "llm_extracted_campaign_site_websearch"
        },
        "civic_affiliations": {
          "value": "President of the Pennsylvania Professional Fire Fighters Association",
          "source_url": "https://www.electbobbrooks.net/",
          "snippet": "As the union President of the Pennsylvania Professional Fire Fighters Association, Bob took on the politicians for higher wages, better healthcare, and benefits for all workers.",
          "source_type": "llm_extracted_campaign_site_websearch"
        }
